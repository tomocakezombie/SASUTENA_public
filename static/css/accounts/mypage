*{box-sizing:border-box;font-family:Yu Gothic, 'Hiragino Kaku Gothic ProN', Meiryo, sans-serif}
body{background:#f4f7fb;color:#222;margin:0;padding:20px}
.container{max-width:900px;margin:0 auto}
.card{background:#fff;border-radius:10px;box-shadow:0 2px 10px rgba(15,23,42,0.08);padding:16px;margin:12px 0}
h1{margin:8px 0 18px}
label{display:block;margin:8px 0}
input,select,textarea,button{font-size:14px;padding:8px;border:1px solid #ddd;border-radius:4px}
button{background:#1373e6;color:#fff;border:none;cursor:pointer}
button.secondary{background:#666}
.item{border-bottom:1px solid #e4e7ec;padding:10px 0;display:flex;gap:16px;align-items:flex-start}
.item img{width:96px;height:96px;object-fit:cover;border-radius:8px}
.tags{font-size:12px;color:#666}
.note{font-size:13px;color:#555}
.topbar{display:flex;justify-content:space-between;align-items:center}
.searchRow{display:flex;gap:8px;align-items:center;margin:8px 0}
.small{font-size:13px;color:#666}
.link{color:#1373e6;text-decoration:underline;cursor:pointer}
.footer{font-size:13px;color:#777;margin-top:20px;text-align:center}
body.bootstrap-enabled{padding:0}
body.bootstrap-enabled .container{max-width:1024px}
body.bootstrap-enabled .card{margin:0;border-radius:12px}
.item-photo{width:96px;height:96px;object-fit:cover;border-radius:12px;flex-shrink:0;box-shadow:0 1px 4px rgba(15,23,42,0.12)}
.item-photo-lg{width:200px;height:200px;object-fit:cover;border-radius:16px;flex-shrink:0;box-shadow:0 2px 10px rgba(15,23,42,0.12)}
.item-photo-placeholder{display:flex;align-items:center;justify-content:center;background:#f4f6fb;border:1px dashed #c9d2e3;border-radius:12px;color:#7a8598;font-size:12px;flex-shrink:0;width:96px;height:96px}
.item-photo-placeholder-lg{width:200px;height:200px;border-radius:16px}
.link-card{transition:transform .15s ease, box-shadow .15s ease}
.link-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(15,23,42,0.15)}
.link-icon{display:inline-flex;width:42px;height:42px;border-radius:12px;align-items:center;justify-content:center;font-size:1.25rem}
.link-icon-primary{background:#e7f1ff;color:#0b63ce}
.link-icon-secondary{background:#f1f3f8;color:#4a5568}
.link-icon-success{background:#e7f9f3;color:#0f7a49}
.link-icon-warning{background:#fff4e5;color:#c05621}
.badge{background:#eef2ff;color:#3b4cca}